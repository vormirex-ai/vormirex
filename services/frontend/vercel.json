{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vormirex-backend.vercel.app/api/$1"
    },
    {
      "source": "/((?!assets/|favicon.ico|logo.png|manifest.json|robots.txt|sitemap.xml|.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
